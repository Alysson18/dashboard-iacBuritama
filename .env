# URL do backend compartilhado (checkin-api) — multi-igreja, cada usuário seleciona sua
# igreja após o login (não depende mais de domínio/deploy por igreja).
REACT_APP_API_URL=https://checkin-api.iacburitama.com.br

# Integração WhatsApp via Embedded Signup (app Meta novo, criado em 07/2026)
# App ID e Configuration ID não são segredo (ficam expostos no client para o SDK da Meta).
# App Secret NUNCA vai aqui - fica só no backend (checkin-api/api/core/.env).
REACT_APP_META_APP_ID=1322276430114393
REACT_APP_META_CONFIG_ID=1650886037045063
